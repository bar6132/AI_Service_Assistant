# Provider chain, tried in order. "gemini" is the configuration all 10 test
# cases were run against. "grok" (xAI, XAI_API_KEY) and "local" (llama.cpp
# server at LOCAL_BASE_URL) are supported by the code but were not tested.
# Providers without an API key are skipped; an unknown name is a startup error.
PROVIDERS=gemini
GEMINI_API_KEY=
XAI_API_KEY=
LOCAL_BASE_URL=http://localhost:8080/v1

# Fixed reference date for the assignment's test cases. Remove it to evaluate
# against the real current date (Asia/Jerusalem).
TODAY=2026-09-22

# Optional model-id overrides (the design names only "Fast" / "Flash-Lite").
# Leave empty to use the code's defaults.
XAI_MODEL=
GEMINI_MODEL=
